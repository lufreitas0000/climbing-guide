% ========================================================
% LaTeX2e Renderers (ExplSyntaxOff: Safeguards PGF spaces)
% ========================================================
\DeclareDocumentCommand{\CGDrawStarsInternal}{ m }{
    \makebox[0pt][r]{
        \begin{tikzpicture}[baseline=-0.6ex]
            \foreach \i in {1,...,#1} {
                \node[star, star points=5, star point ratio=2.25, fill=cg_yellow_soft, inner sep=0pt, minimum size=0.8em] at (\i*0.8em-0.8em, 0) {};
            }
        \end{tikzpicture}\hspace{0.3em}
    }
}

\DeclareDocumentCommand{\CGDrawRouteBadgeInternal}{ m m }{
    \begin{minipage}[t]{\CGRouteNumberWidth}
        \vspace{0pt}
        \begin{tikzpicture}[baseline=(current bounding box.north)]
            \fill[#1] (0,0) rectangle (\CGRouteBadgeSize, -\CGRouteBadgeSize);
            \node[text=white, font=\CGRouteNumberFont, anchor=center] at (0.5*\CGRouteBadgeSize, -0.5*\CGRouteBadgeSize) {#2};
        \end{tikzpicture}
    \end{minipage}%
}

\DeclareDocumentCommand{\CGDrawSectorHeaderInternal}{ m m m m }{
    \vspace{\CGSectorHeaderSpaceBefore}\noindent
    \begin{tcolorbox}[enhanced, boxrule=0pt, frame hidden, interior hidden, borderline west={3mm}{0pt}{#2}, left=4mm, right=0mm, top=0mm, bottom=0mm, sharp corners]
        #1
        \begin{minipage}[b]{0.45\linewidth}
            \adjustbox{max width=\linewidth}{\CGSectorTitleFont #3}
        \end{minipage}%
        \begin{minipage}[b]{0.55\linewidth}
            \raggedleft #4
        \end{minipage}
    \end{tcolorbox}
    \vspace{\CGSectorHeaderSpaceAfter}
}

% ========================================================
% LaTeX3 Logic & Macros (ExplSyntaxOn)
% ========================================================
\ExplSyntaxOn

\cs_if_exist:NF \l_guide_current_grade_color_tl {
    \tl_new:N \l_guide_current_grade_color_tl
}
\tl_set:Nn \l_guide_current_grade_color_tl { guide_gray }

\DeclareDocumentCommand{\CGObs}{}{
    \textcolor{brand_color}{\CGObservationLabelFont Obs:~}
}

\DeclareDocumentCommand{\obs}{}{\CGObs}
\DeclareDocumentCommand{\Obs}{}{\CGObs}
\DeclareDocumentCommand{\CGstar}{ m }{}

\DeclareDocumentCommand{\CGObservationText}{ m }{
    \par\vspace{1pt}
    {
        \setlength{\baselineskip}{10pt}
        \textcolor{text_body}{\CGObservationFont
        \regex_extract_once:nnNTF { \A \s* \c{CGstar} \s* (?:\cB.)? \s* ([1-3]) \s* (?:\cE.)? \s* (.*) \Z } { #1 } \l_tmpa_seq
        {
            \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 2 } }
            \CGDrawStarsInternal { \l_tmpa_tl }
            \seq_item:Nn \l_tmpa_seq { 3 }
        }
        {
            #1
        }
        }\par
    }
}

\DeclareDocumentCommand{\CGTextSingleColumn}{ m +m }{
    \tl_if_empty:nF {#1} { {\color{brand_color}\CGColumnTitleFont #1}\par\vspace{2pt} }
    {\CGBodyFont #2}\par\vspace{\CGVerticalSpacingDefault}
}

\DeclareDocumentCommand{\CGDoubleTextSection}{ m +m m +m }{
    \begin{multicols}{2}
        \tl_if_empty:nF {#1} { {\color{brand_color}\CGColumnTitleFont #1}\par\vspace{2pt} }
        {\CGBodyFont #2}\par
        \columnbreak
        \tl_if_empty:nF {#3} { {\color{brand_color}\CGColumnTitleFont #3}\par\vspace{2pt} }
        {\CGBodyFont #4}\par
    \end{multicols}
}

\DeclareDocumentCommand{\CGSectorHeader}{ O{SETOR} m m }{
    \cs_if_exist:NT \guide_save_sector_summary: { \guide_save_sector_summary: }
    \int_gincr:N \g_guide_sector_int
    \cs_if_exist:NT \g_guide_current_sector_name_tl { \tl_gset:Nn \g_guide_current_sector_name_tl {#3} }
    \directlua{cg.set_sector("\luaescapestring{\unexpanded{#3}}")}
    
    \phantomsection
    \addcontentsline{toc}{section}{#3}
    \CGSetHeaderRight{#3}

    \int_gzero:N \g_guide_cyan_top_int \int_gzero:N \g_guide_cyan_bot_int
    \int_gzero:N \g_guide_green_top_int \int_gzero:N \g_guide_green_bot_int
    \int_gzero:N \g_guide_yellow_top_int \int_gzero:N \g_guide_yellow_bot_int
    \int_gzero:N \g_guide_orange_top_int \int_gzero:N \g_guide_orange_bot_int
    \int_gzero:N \g_guide_red_top_int \int_gzero:N \g_guide_red_bot_int
    \int_gzero:N \g_guide_gray_int

    \CGDrawSectorHeaderInternal { \tl_if_empty:nF {#1} { {\color{#2}\CGSectorHeaderLabelFont #1}\\[2pt] } } {#2} {#3} {
        \cs_if_exist:cT { GuideSectorSummary \int_use:N \g_guide_sector_int } {
            \use:c { GuideSectorSummary \int_use:N \g_guide_sector_int }
        }
    }
}

\DeclareDocumentEnvironment{CGSectorRoutes}{ O{} +b }{
    \regex_count:nnN { \c{CGRoute} } { #2 } \l_tmpa_int
    \int_set:Nn \l_tmpb_int { 1 }
    \tl_if_empty:nTF { #1 } {
        \int_compare:nNnT { \l_tmpa_int } > { 8 } { \int_set:Nn \l_tmpb_int { 2 } }
    } {
        \int_set:Nn \l_tmpb_int { #1 }
    }
    \int_compare:nNnTF { \l_tmpb_int } > { 1 } {
        \begin{multicols}{\l_tmpb_int}
        #2
        \end{multicols}
    } {
        #2
    }
}{}

\DeclareDocumentCommand{\CGEvalGrade}{ m m }{
    \tl_gset:Nn \l_guide_current_grade_color_tl { #1 }
    \tl_if_empty:nTF { #2 } {
        \int_gincr:N \g_guide_gray_int
    } {
        \cs_if_exist:cT { g_guide_#2_int } {
            \int_gincr:c { g_guide_#2_int }
        }
    }
}

\DeclareDocumentCommand{\CGRoute}{ m m m m m o }{
    \int_gincr:N \g_guide_route_int
    \IfValueTF{#6}{
        \directlua{cg.register_route("\int_use:N \g_guide_route_int", "\luaescapestring{\unexpanded{#1}}", "\luaescapestring{\unexpanded{#2}}", "\luaescapestring{\unexpanded{#3}}", "\luaescapestring{\unexpanded{#4}}", "\luaescapestring{\unexpanded{#5}}", "\luaescapestring{\unexpanded{#6}}")}
    }{
        \directlua{cg.register_route("\int_use:N \g_guide_route_int", "\luaescapestring{\unexpanded{#1}}", "\luaescapestring{\unexpanded{#2}}", "\luaescapestring{\unexpanded{#3}}", "\luaescapestring{\unexpanded{#4}}", "\luaescapestring{\unexpanded{#5}}", "")}
    }
    \directlua{cg.eval_tex("\luaescapestring{\unexpanded{#2}}")}

    \noindent
    \CGDrawRouteBadgeInternal { \l_guide_current_grade_color_tl } { \int_use:N \g_guide_route_int }
    \begin{minipage}[t]{\dimexpr\linewidth-\CGRouteNumberWidth\relax}
        \vspace{0pt}\raggedright\setlength{\baselineskip}{13pt}
        \sbox0{\hspace{0.5em}{\CGGradeFont #2} \textcolor{guide_gray}{|} {\CGGradeFont #3} \tl_if_empty:nF {#4} { {\CGGradeFont (#4)} }}%
        \sbox1{{\CGRouteNameFont #1}}%
        \dimen0=\dimexpr\linewidth-\wd0\relax
        \ifdim\wd1>\dimen0
            \resizebox{\dimen0}{\ht1}{\usebox1}%
        \else
            \usebox1
        \fi
        \usebox0\par
        {\CGSetterFont #5}
        \IfValueT{#6}{ \CGObservationText{#6} }
    \end{minipage}\par\vspace{3mm}
}

\DeclareDocumentCommand{\CGZoneStats}{ m }{
    \str_if_eq:nnTF {#1} {Global} {
        \cs_if_exist:NTF \CGGlobalChart { \CGGlobalChart } { \textsl{Gráfico global disponível na próxima compilação...} }
    } {
        \directlua{cg.render_zone_stats("\luaescapestring{\unexpanded{#1}}")}
    }
}
