% --- Automated Formatting Tolerances & Character Patches ---
% 1. Global LuaTeX Input Buffer Interception for U+00A0
% This intercepts the file stream BEFORE tokenization, replacing UTF-8 bytes 194 160 with a standard space.
\directlua{
  luatexbase.add_to_callback('process_input_buffer', function(line)
    return line:gsub(string.char(194, 160), ' ')
  end, 'sanitize_nbsp')
}

