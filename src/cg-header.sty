\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cg-header}[2026/09/02 Header and Footer Management]

\RequirePackage{fancyhdr}
\RequirePackage{xparse}
\RequirePackage{cg-theme} % Replaced cg-fonts and cg-colors

\ExplSyntaxOn
\tl_new:N \g_guide_header_left_tl
\tl_new:N \g_guide_header_right_tl
\tl_new:N \g_guide_footer_center_tl

\tl_gset:Nn \g_guide_header_left_tl { Climbing~Guide }
\tl_gset:Nn \g_guide_header_right_tl { Documentation }
\tl_gset:Nn \g_guide_footer_center_tl { \thepage }

\DeclareDocumentCommand{\CGSetHeaderLeft}{ m }{
  \tl_gset:Nn \g_guide_header_left_tl { #1 }
}

\DeclareDocumentCommand{\CGSetHeaderRight}{ m }{
  \tl_gset:Nn \g_guide_header_right_tl { #1 }
}

\DeclareDocumentCommand{\CGSetFooterCenter}{ m }{
  \tl_gset:Nn \g_guide_footer_center_tl { #1 }
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\fancyhead[LE]{\textcolor{brand_color}{\CGHeaderFont \tl_use:N \g_guide_header_left_tl}}
\fancyhead[RO]{\textcolor{brand_color}{\CGHeaderFont \tl_use:N \g_guide_header_right_tl}}
\fancyfoot[C]{\CGHeaderFont \tl_use:N \g_guide_footer_center_tl}

% Suppress headers and footers on plain chapter/zone pages
\fancypagestyle{plain}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}
\ExplSyntaxOff

\endinput
