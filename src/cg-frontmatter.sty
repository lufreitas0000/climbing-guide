\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cg-frontmatter}[2026/08/27 Front Matter]
\RequirePackage{tocloft}

% TOC Customization
\renewcommand{\cfttoctitlefont}{\color{brand_color}\CGFrontmatterTocTitleFont}
\renewcommand{\cftpartfont}{\color{text_body}\CGFrontmatterPartFont}
\renewcommand{\cftsecfont}{\color{text_body}\CGFrontmatterSecFont}
\renewcommand{\cftpartpagefont}{\color{text_body}\CGFrontmatterSecFont}
\renewcommand{\cftsecpagefont}{\color{text_body}\CGFrontmatterSecFont}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\setlength{\cftbeforepartskip}{10pt}
\setlength{\cftbeforesecskip}{2pt}
\setlength{\cftsecindent}{1em}

\ExplSyntaxOn
\DeclareDocumentCommand{\CGSidebarTitle}{ m }{
    \vspace{1em}\noindent
    \begin{tikzpicture}[baseline=(current~bounding~box.north)]
        \fill[brand_color] (0,0) rectangle (4mm, -10mm);
        \node[anchor=north~west, inner~sep=0pt, xshift=6mm, yshift=-1.5mm] at (0,0) {
            \CGSidebarTitleFont #1
        };
    \end{tikzpicture}\par\vspace{1em}
}

\DeclareDocumentCommand{\CGSplitBackground}{ O{0.5} m m }{
    \begin{tikzpicture}[remember~picture, overlay]
        \fill[#2] (current~page.north~west) rectangle ($ (current~page.south~west) !#1! (current~page.south~east) $);
        \fill[#3] ($ (current~page.north~west) !#1! (current~page.north~east) $) rectangle (current~page.south~east);
    \end{tikzpicture}
}

\DeclareDocumentCommand{\CGIndexCorner}{}{
    \begin{tikzpicture}[remember~picture, overlay]
        \fill[brand_color] ($ (current~page.north~west) + (0, 0) $) rectangle ($ (current~page.north~west) + (11.25mm, -22mm) $);
        \node[anchor=south~west, inner~sep=0pt, text=black] at ($ (current~page.north~west) + (\CGMarginWidth, -22mm) $) {
            \CGIndexTitleFont Índice
        };
    \end{tikzpicture}
}

\DeclareDocumentCommand{\CGIndexBackground}{}{
    \begin{tikzpicture}[remember~picture, overlay]
        \fill[bg_beige] ($ (current~page.north~west) + (11.25mm, -22mm) $) rectangle ($ (current~page.north~west) + (11.25mm + 0.55\textwidth, -180mm) $);
    \end{tikzpicture}
}

\DeclareDocumentCommand{\CGCoverPage}{ m m m }{ 
    \begin{tikzpicture}[remember~picture, overlay] 
        \clip (current~page.north~west) rectangle (current~page.south~east); 
        \node[anchor=center, inner~sep=0pt] at (current~page.center) { 
            \includegraphics[min~width=\paperwidth, min~height=\paperheight,keepaspectratio]{#1} 
        }; 
        \node[anchor=north, text=brand_color, inner~sep=0pt, align=center] at ($ (current~page.north) + (0, -25mm) $) { 
            \CGCoverMainFont #2 
        }; 
        \node[anchor=north, text=black, inner~sep=0pt, align=center] at ($ (current~page.north) + (0, -10mm) $) { 
            \CGCoverTypeFont GUIA~DE~ESCALADA 
        }; 
        \node[anchor=south, text=white, inner~sep=0pt, align=center] at ($ (current~page.south) + (0, 30mm) $) { 
            \CGCoverTypeFont #3 
        }; 
    \end{tikzpicture} 
    \clearpage 
} 
\ExplSyntaxOff
