\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cg-theme}[2026/09/02 Theme and Geometry]

\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{geometry}

% Primary Brand & Neutral Tiers
\definecolor{brand_color}{HTML}{BE1E2D}
\definecolor{text_body}{HTML}{2D2D2D}
\definecolor{bg_beige}{HTML}{EFECE6}

% Grade Scale Tier Colors
\definecolor{guide_cyan}{HTML}{00AEEF}
\definecolor{guide_green}{HTML}{009640}
\definecolor{guide_yellow}{HTML}{F29400}
\definecolor{guide_orange}{HTML}{F05A28}
\definecolor{guide_red}{HTML}{BE1E2D}
\definecolor{guide_purple}{HTML}{92278F}
\definecolor{guide_gray}{HTML}{3A3A3C}

% Extended Accent Palette
\definecolor{cg_yellow_soft}{HTML}{F9DC5C}
\definecolor{cg_sage}{HTML}{87A96B}
\definecolor{cg_indigo}{HTML}{4B6B94}
\definecolor{cg_obs_gray}{HTML}{7A7A7A}

% Base Font Family Definitions
\newfontfamily\CGTitleFont{Barlow Condensed}[Ligatures=TeX, UprightFont={* Regular}, BoldFont={* Bold},ItalicFont={* Regular},BoldItalicFont={* Bold}]
\newfontfamily\CGCoverFont{Bebas Neue}[Ligatures=TeX,ItalicFont={* Regular},BoldFont={* Regular},BoldItalicFont={* Regular}]

\newcommand{\CGBaseFont}{\sffamily\selectfont}
\newcommand{\CGItalicFont}{\sffamily\itshape\selectfont}

% Semantic Font Aliases
\newcommand{\CGHeaderFont}{\CGTitleFont\fontsize{9}{11}\selectfont}
\newcommand{\CGCoverMainFont}{\CGCoverFont\fontsize{90}{90}\selectfont}
\newcommand{\CGCoverSubtitleFont}{\CGTitleFont\fontsize{14}{18}\selectfont}
\newcommand{\CGCoverTypeFont}{\CGTitleFont\fontsize{18}{22}\selectfont}
\newcommand{\CGZoneTitleFont}{\CGCoverFont\fontsize{26}{28}\selectfont}

\newcommand{\CGSectorLabelFont}{\CGTitleFont\fontsize{10}{12}\selectfont}
\newcommand{\CGSectorTitleFont}{\CGTitleFont\fontsize{24}{28}\selectfont}
\newcommand{\CGSectorHeaderLabelFont}{\CGTitleFont\fontsize{14}{16}\selectfont}

\newcommand{\CGRouteNumberFont}{\CGTitleFont\bfseries\fontsize{14}{14}\selectfont}
\newcommand{\CGRouteNameFont}{\CGTitleFont\bfseries\fontsize{11}{14}\selectfont}
\newcommand{\CGGradeFont}{\CGItalicFont\fontsize{10}{12}\selectfont}
\newcommand{\CGGearFont}{\CGItalicFont\fontsize{10}{12}\selectfont}

\newcommand{\CGSetterFont}{\CGItalicFont\bfseries\fontsize{9}{11}\selectfont}
\newcommand{\CGObservationLabelFont}{\CGTitleFont\bfseries\fontsize{8}{10}\selectfont}
\newcommand{\CGObservationFont}{\CGItalicFont\fontsize{7}{9}\selectfont}

\newcommand{\CGBodyFont}{\CGBaseFont\fontsize{10}{14}\selectfont}
\newcommand{\CGColumnTitleFont}{\CGTitleFont\fontsize{18}{22}\selectfont}

\newcommand{\CGFrontmatterTocTitleFont}{\CGTitleFont\fontsize{32}{36}\selectfont}
\newcommand{\CGFrontmatterPartFont}{\CGTitleFont\fontsize{12}{14}\selectfont}
\newcommand{\CGFrontmatterSecFont}{\CGBaseFont\fontsize{10}{12}\selectfont}

\newcommand{\CGSidebarTitleFont}{\CGTitleFont\fontsize{28}{32}\selectfont}
\newcommand{\CGIndexTitleFont}{\CGTitleFont\fontsize{32}{36}\selectfont}

\newcommand{\CGSummaryNumberFont}{\CGItalicFont\fontsize{11}{13}\selectfont}

\newcommand{\CGListRouteNameFont}{\CGBaseFont\bfseries\fontsize{10}{12}\selectfont}
\newcommand{\CGListSectorFont}{\CGBaseFont\fontsize{9}{11}\selectfont}
\newcommand{\CGListGradeFont}{\CGBaseFont\itshape\fontsize{10}{12}\selectfont}

\renewcommand{\familydefault}{\sfdefault}

% Geometry
\geometry{
  paperwidth=150mm, paperheight=210mm, margin=10mm,
  top=11mm, bottom=15mm, headheight=15pt, headsep=6mm, twoside
}

\setlength{\columnsep}{4mm}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{15pt}
\tolerance=2000
\hbadness=1999

% Centralized Layout Dimensions
\newlength{\CGSummaryBoxSize}\setlength{\CGSummaryBoxSize}{0.8cm}
\newlength{\CGMarginWidth}\setlength{\CGMarginWidth}{15mm}
\newlength{\CGRouteBadgeSize}\setlength{\CGRouteBadgeSize}{6mm}
\newlength{\CGRouteNumberWidth}\setlength{\CGRouteNumberWidth}{8mm}
\newlength{\CGZoneBannerHeight}\setlength{\CGZoneBannerHeight}{62.5mm}
\newlength{\CGVerticalSpacingDefault}\setlength{\CGVerticalSpacingDefault}{4mm}
\newlength{\CGSectorHeaderSpaceBefore}\setlength{\CGSectorHeaderSpaceBefore}{2em}
\newlength{\CGSectorHeaderSpaceAfter}\setlength{\CGSectorHeaderSpaceAfter}{1em}

\endinput
