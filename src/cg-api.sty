\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cg-api}[2026/08/27 API State Management]

\directlua{cg = require("climbingguide")}

\ExplSyntaxOn
\int_new:N \g_guide_route_int
\int_new:N \g_guide_sector_int
\tl_new:N \g_guide_current_sector_name_tl
\tl_new:N \l_guide_current_grade_color_tl

\int_new:N \g_guide_cyan_top_int \int_new:N \g_guide_cyan_bot_int
\int_new:N \g_guide_green_top_int \int_new:N \g_guide_green_bot_int
\int_new:N \g_guide_yellow_top_int \int_new:N \g_guide_yellow_bot_int
\int_new:N \g_guide_orange_top_int \int_new:N \g_guide_orange_bot_int
\int_new:N \g_guide_red_top_int \int_new:N \g_guide_red_bot_int
\int_new:N \g_guide_purple_top_int \int_new:N \g_guide_purple_bot_int
\int_new:N \g_guide_gray_int

\cs_new:Npn \guide_save_sector_summary: {
    \int_compare:nNnT { \g_guide_sector_int } > { 0 } {
        \iow_now:Nx \@auxout {
            \exp_not:N \global \exp_not:N \@namedef { GuideSectorSummary \int_use:N \g_guide_sector_int } {
                \exp_not:N \DrawSummaryBlock {guide_cyan} { \int_use:N \g_guide_cyan_top_int } { \int_use:N \g_guide_cyan_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_green} { \int_use:N \g_guide_green_top_int } { \int_use:N \g_guide_green_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_yellow} { \int_use:N \g_guide_yellow_top_int } { \int_use:N \g_guide_yellow_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_orange} { \int_use:N \g_guide_orange_top_int } { \int_use:N \g_guide_orange_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_red} { \int_use:N \g_guide_red_top_int } { \int_use:N \g_guide_red_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_purple} { \int_use:N \g_guide_purple_top_int } { \int_use:N \g_guide_purple_bot_int }
                \exp_not:N \DrawSummaryBlockSingle {guide_gray} { \int_use:N \g_guide_gray_int }
            }
        }
    }
}
\AtEndDocument{
    \guide_save_sector_summary:
    \directlua{cg.export_json("export/database.json")}
    \directlua{cg.export_text_lists("export/")}
}

\NewDocumentCommand{\CGEvalGrade}{ m m }{
    \tl_set:Nn \l_guide_current_grade_color_tl {#1}
    \tl_if_empty:nF {#2} { \int_gincr:c {g_guide_#2_int} }
}
\ExplSyntaxOff
\providecommand{\CGTotalRoutes}{?}
