\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cg-api}[2026/08/26 API]
\RequirePackage{xparse}

\directlua{cg = require("climbingguide")}

\ExplSyntaxOn
\int_new:N \g_guide_route_int
\int_new:N \g_guide_sector_int
\tl_new:N \g_guide_current_sector_name_tl
\tl_new:N \l_guide_current_grade_color_tl

\int_new:N \g_guide_cyan_top_int \int_new:N \g_guide_cyan_bot_int
\int_new:N \g_guide_green_top_int \int_new:N \g_guide_green_bot_int
\int_new:N \g_guide_yellow_top_int \int_new:N \g_guide_yellow_bot_int
\int_new:N \g_guide_orange_top_int \int_new:N \g_guide_orange_bot_int
\int_new:N \g_guide_red_top_int \int_new:N \g_guide_red_bot_int
\int_new:N \g_guide_purple_top_int \int_new:N \g_guide_purple_bot_int
\int_new:N \g_guide_gray_int

\cs_new:Npn \guide_save_sector_summary: {
    \int_compare:nNnT { \g_guide_sector_int } > { 0 } {
        \iow_now:Nx \@auxout {
            \exp_not:N \global \exp_not:N \@namedef { GuideSectorSummary \int_use:N \g_guide_sector_int } {
                \exp_not:N \DrawSummaryBlock {guide_cyan} { \int_use:N \g_guide_cyan_top_int } { \int_use:N \g_guide_cyan_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_green} { \int_use:N \g_guide_green_top_int } { \int_use:N \g_guide_green_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_yellow} { \int_use:N \g_guide_yellow_top_int } { \int_use:N \g_guide_yellow_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_orange} { \int_use:N \g_guide_orange_top_int } { \int_use:N \g_guide_orange_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_red} { \int_use:N \g_guide_red_top_int } { \int_use:N \g_guide_red_bot_int }
                \exp_not:N \DrawSummaryBlock {guide_purple} { \int_use:N \g_guide_purple_top_int } { \int_use:N \g_guide_purple_bot_int }
                \exp_not:N \DrawSummaryBlockSingle {guide_gray} { \int_use:N \g_guide_gray_int }
            }
        }
    }
}
\AtEndDocument{ 
    \guide_save_sector_summary: 
    \directlua{cg.export_json("export/database.json")}
}

\NewDocumentCommand{\CGEvalGrade}{ m m }{
    \tl_set:Nn \l_guide_current_grade_color_tl {#1}
    \tl_if_empty:nF {#2} { \int_gincr:c {g_guide_#2_int} }
}

% Macro: Adjusts vertical spacing and font size exclusively for optional route text
\NewDocumentCommand{\CGObservationText}{ m }{
    \par\vspace{1pt}
    {
        \setlength{\baselineskip}{10pt}
        \CGItalicFont\footnotesize
        \textcolor{brand_color}{Obs:~}\textcolor{text_body}{#1}\par
    }
}

\NewDocumentCommand{\CGTextSingleColumn}{ m m }{
    \tl_if_empty:nF {#1} { {\CGTitleFont\LARGE\color{brand_color} #1}\par\vspace{2pt} }
    {\CGBaseFont\normalsize #2}\par\vspace{4mm}
}

\NewDocumentCommand{\CGDoubleTextSection}{ m m m m }{
    \begin{multicols}{2}
        \tl_if_empty:nF {#1} { {\CGTitleFont\LARGE\color{brand_color} #1}\par\vspace{2pt} }
        {\CGBaseFont\normalsize #2}\par
        \columnbreak
        \tl_if_empty:nF {#3} { {\CGTitleFont\LARGE\color{brand_color} #3}\par\vspace{2pt} }
        {\CGBaseFont\normalsize #4}\par
    \end{multicols}
}

\NewDocumentCommand{\CGSectorHeader}{ m m }{
    \guide_save_sector_summary:
    \int_gincr:N \g_guide_sector_int
    \tl_gset:Nn \g_guide_current_sector_name_tl {#2}
    \directlua{cg.set_sector("\luaescapestring{\unexpanded{#2}}")}
    
    \int_gzero:N \g_guide_cyan_top_int \int_gzero:N \g_guide_cyan_bot_int
    \int_gzero:N \g_guide_green_top_int \int_gzero:N \g_guide_green_bot_int
    \int_gzero:N \g_guide_yellow_top_int \int_gzero:N \g_guide_yellow_bot_int
    \int_gzero:N \g_guide_orange_top_int \int_gzero:N \g_guide_orange_bot_int
    \int_gzero:N \g_guide_red_top_int \int_gzero:N \g_guide_red_bot_int
    \int_gzero:N \g_guide_gray_int

    \vspace{2em}\noindent
    \begin{tcolorbox}[enhanced, boxrule=0pt, frame~hidden, interior~hidden, borderline~west={3mm}{0pt}{#1}, left=4mm, right=0mm, top=0mm, bottom=0mm, sharp~corners]
        {\CGTitleFont\large\color{#1} SETOR}\\[2pt]
        \begin{minipage}[b]{0.45\textwidth}
            \CGTitleFont\fontsize{24}{28}\selectfont #2
        \end{minipage}%
        \begin{minipage}[b]{0.55\textwidth}
            \raggedleft
            \cs_if_exist:cT { GuideSectorSummary \int_use:N \g_guide_sector_int } {
                \use:c { GuideSectorSummary \int_use:N \g_guide_sector_int }
            }
        \end{minipage}
    \end{tcolorbox}
    \vspace{1em}
}

\NewDocumentCommand{\CGRoute}{ m m m m m o }{
    \int_gincr:N \g_guide_route_int
    \directlua{cg.register_route("\int_use:N \g_guide_route_int", "\luaescapestring{\unexpanded{#1}}", "\luaescapestring{\unexpanded{#2}}", "\luaescapestring{\unexpanded{#3}}", "\luaescapestring{\unexpanded{#4}}", "\luaescapestring{\unexpanded{#5}}")}
    \directlua{cg.eval_tex("\luaescapestring{\unexpanded{#2}}")}
    
    \noindent
    \begin{minipage}[t]{8mm}
        \vspace{0pt}
        \begin{tikzpicture}[baseline=(current~bounding~box.north)]
            \fill[\l_guide_current_grade_color_tl] (0,0) rectangle (6mm, -6mm);
            \node[text=white, font=\CGTitleFont\bfseries\large, anchor=center] at (3mm, -3mm) {\int_use:N \g_guide_route_int};
        \end{tikzpicture}
    \end{minipage}%
    \begin{minipage}[t]{\dimexpr\linewidth-8mm\relax}
        \vspace{0pt}\raggedright\setlength{\baselineskip}{13pt}
        \sbox0{~{\CGItalicFont\normalsize #2} \textcolor{guide_gray}{|} {\CGItalicFont\normalsize #3} \tl_if_empty:nF {#4} { {\CGItalicFont\normalsize (#4)} }}%
        \sbox1{{\CGTitleFont\bfseries\large #1}}%
        \dimen0=\dimexpr\linewidth-\wd0\relax
        \ifdim\wd1>\dimen0
            \resizebox{\dimen0}{\ht1}{\usebox1}%
        \else
            \usebox1
        \fi
        \usebox0\par
        {\CGItalicFont\small #5}
        \IfValueT{#6}{ \CGObservationText{#6} }
    \end{minipage}\par\vspace{3mm}
}
\ExplSyntaxOff
\endinput
