\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cg-boxes}[2026/08/29 Boxes]
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable}
\RequirePackage{tikz}
\usetikzlibrary{calc, positioning}

\ifdefined\CGSummaryBoxSize\relax\else
  \newlength{\CGSummaryBoxSize}
  \setlength{\CGSummaryBoxSize}{0.8cm}
\fi
\ifdefined\CGZoneBannerHeight\relax\else
  \newlength{\CGZoneBannerHeight}
  \setlength{\CGZoneBannerHeight}{62.5mm}
\fi
\ifdefined\CGMarginWidth\relax\else
  \newlength{\CGMarginWidth}
  \setlength{\CGMarginWidth}{15mm}
\fi
\ifdefined\CGVerticalSpacingDefault\relax\else
  \newlength{\CGVerticalSpacingDefault}
  \setlength{\CGVerticalSpacingDefault}{4mm}
\fi

\newcounter{cgfigure}

\ExplSyntaxOn
\NewDocumentCommand{\CGObsBox}{ m }{
    \begin{tcolorbox}[colback=bg_beige, colframe=bg_beige, boxrule=0pt, arc=0pt, left=4mm, right=4mm, top=3mm, bottom=3mm, width=\linewidth, sharp~corners]
        \color{text_body}\CGBodyFont #1
    \end{tcolorbox}
}
\NewDocumentCommand{\CGZoneHeader}{ m m }{
    \directlua{cg.set_zone("\luaescapestring{\unexpanded{#2}}")}
    \addcontentsline{toc}{part}{#2}
    
    % Dynamically update running page headers
    \CGSetHeaderLeft{#2}
    \CGSetHeaderRight{}

    \begin{tikzpicture}[remember~picture, overlay]
        \clip (current~page.north~west) rectangle ($ (current~page.north~east) + (0, -\CGZoneBannerHeight) $);
        \node[anchor=north, inner~sep=0pt] at ($ (current~page.north) + (0, 0) $) {
            \includegraphics[width=\paperwidth]{#1}
        };
    \end{tikzpicture}
    \begin{tikzpicture}[remember~picture, overlay]
        \fill[brand_color] ($ (current~page.north~west) + (0, -\CGZoneBannerHeight + 8mm) $) rectangle ($ (current~page.north~west) + (\CGMarginWidth + 0.75\textwidth, -\CGZoneBannerHeight - 8mm) $);
        \node[anchor=west, text=white, inner~sep=0pt] at ($ (current~page.north~west) + (\CGMarginWidth, -\CGZoneBannerHeight) $) {
            \CGZoneTitleFont ZONA~#2
        };
    \end{tikzpicture}
    \vspace*{60.5mm}
}
\NewDocumentCommand{\DrawSummaryBlock}{ m m m }{
    \begin{tikzpicture}[baseline=0pt]
        \useasboundingbox (0,0) rectangle (\CGSummaryBoxSize,\CGSummaryBoxSize);
        \fill[#1] (0,0) rectangle (\CGSummaryBoxSize,\CGSummaryBoxSize);
        \fill[#1!60!black] (0,0) -- (\CGSummaryBoxSize,0) -- (\CGSummaryBoxSize,\CGSummaryBoxSize) -- cycle;
        \node[text=white, font=\CGSummaryNumberFont, anchor=center] at (0.33*\CGSummaryBoxSize, 0.67*\CGSummaryBoxSize) {#2};
        \node[text=white, font=\CGSummaryNumberFont, anchor=center] at (0.67*\CGSummaryBoxSize, 0.33*\CGSummaryBoxSize) {#3};
    \end{tikzpicture}\hspace{0.0pt}%
}
\NewDocumentCommand{\DrawSummaryBlockSingle}{ m m }{
    \begin{tikzpicture}[baseline=0pt]
        \useasboundingbox (0,0) rectangle (\CGSummaryBoxSize,\CGSummaryBoxSize);
        \fill[#1!80!black] (0,0) rectangle (\CGSummaryBoxSize,\CGSummaryBoxSize);
        \node[text=white, font=\CGSummaryNumberFont, anchor=center] at (0.5*\CGSummaryBoxSize, 0.5*\CGSummaryBoxSize) {#2};
    \end{tikzpicture}\hspace{0.0pt}%
}
\NewDocumentCommand{\CGTopoImage}{ o m }{
     \vspace{2mm}\noindent
     \includegraphics[width=\textwidth]{#2}
     \IfValueT{#1}{
         \par\vspace{2pt}\noindent
         \stepcounter{cgfigure}
         {\CGItalicFont\textcolor{brand_color}{Figura~\thecgfigure:}~#1}
     }
     \par\vspace{\CGVerticalSpacingDefault}
}
\ExplSyntaxOff
\endinput
